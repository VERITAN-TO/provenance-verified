{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provenanceverified.org/schemas/credential.schema.json",
  "title": "PROVENANCE VERIFIED™ Credential Case",
  "type": "object",
  "required": [
    "id",
    "publicId",
    "issuer",
    "platform",
    "program",
    "subject",
    "status",
    "eligibleTier",
    "eligibleTierName",
    "tier",
    "tierName",
    "disclosure",
    "authorization",
    "sealAuthorization",
    "claims",
    "evidence",
    "sources",
    "custody",
    "lifecycle",
    "version",
    "signature",
    "integrityHash",
    "warnings",
    "testMode"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "publicId": {
      "type": "string",
      "pattern": "^PV-[A-Z0-9]{4}-[A-Z0-9]{6}$"
    },
    "issuer": {
      "const": "VERITAN, INC."
    },
    "platform": {
      "const": "PROVENANCE VERIFIED"
    },
    "program": {
      "const": "Provenance Verified™"
    },
    "subject": {
      "type": "object",
      "required": [
        "assetType",
        "assetId",
        "description"
      ],
      "properties": {
        "assetType": {
          "type": "string"
        },
        "assetId": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "not-issued",
        "issued"
      ]
    },
    "eligibleTier": {
      "enum": [
        1,
        2,
        3,
        4
      ]
    },
    "eligibleTierName": {
      "enum": [
        "Self-Reported",
        "Bronze",
        "Silver",
        "Gold"
      ]
    },
    "tier": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 4
    },
    "tierName": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "Self-Reported",
        "Bronze",
        "Silver",
        "Gold",
        null
      ]
    },
    "disclosure": {
      "type": "string"
    },
    "authorization": {
      "type": "object",
      "required": [
        "eligibleTier",
        "status",
        "credentialAuthorized",
        "sealAuthorized",
        "requiredApprovalCount",
        "acceptedApprovalCount",
        "blockers",
        "reasonCodes"
      ],
      "properties": {
        "eligibleTier": {
          "enum": [
            1,
            2,
            3,
            4
          ]
        },
        "status": {
          "enum": [
            "not-eligible",
            "review-required",
            "review-rejected",
            "independent-review-required",
            "second-approval-required",
            "reviewer-conflict",
            "conflict-clearance-required",
            "custos-required",
            "signing-key-required",
            "registry-required",
            "revocation-control-required",
            "authorized"
          ]
        },
        "credentialAuthorized": {
          "type": "boolean"
        },
        "sealAuthorized": {
          "type": "boolean"
        },
        "requiredApprovalCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "acceptedApprovalCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reasonCodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "sealAuthorization": {
      "type": "object",
      "required": [
        "status",
        "tier",
        "reasonCodes"
      ],
      "properties": {
        "status": {
          "enum": [
            "not-authorized",
            "authorized"
          ]
        },
        "tier": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 4
        },
        "reasonCodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "claims": {
      "type": "array"
    },
    "evidence": {
      "type": "array"
    },
    "sources": {
      "type": "array"
    },
    "custody": {
      "type": "array"
    },
    "lifecycle": {
      "enum": [
        "draft",
        "active",
        "suspended",
        "superseded",
        "revoked",
        "expired",
        "not-found"
      ]
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "signature": {
      "type": "object",
      "required": [
        "status",
        "algorithm",
        "keyId",
        "value",
        "valid"
      ],
      "properties": {
        "status": {
          "enum": [
            "not-issued",
            "valid",
            "invalid",
            "key-unavailable",
            "revoked-key"
          ]
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "keyId": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "valid": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "integrityHash": {
      "type": "string",
      "pattern": "^sha256:"
    },
    "successorId": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "testMode": {
      "const": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "not-issued"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "tier": {
            "const": null
          },
          "tierName": {
            "const": null
          },
          "signature": {
            "properties": {
              "valid": {
                "const": false
              },
              "value": {
                "const": ""
              }
            }
          },
          "lifecycle": {
            "const": "draft"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "issued"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "issuedAt"
        ],
        "properties": {
          "tier": {
            "enum": [
              1,
              2,
              3,
              4
            ]
          },
          "tierName": {
            "enum": [
              "Self-Reported",
              "Bronze",
              "Silver",
              "Gold"
            ]
          },
          "authorization": {
            "properties": {
              "credentialAuthorized": {
                "const": true
              },
              "status": {
                "const": "authorized"
              }
            }
          },
          "signature": {
            "properties": {
              "status": {
                "const": "valid"
              },
              "valid": {
                "const": true
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
