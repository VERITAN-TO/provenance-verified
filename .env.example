# Browser-visible environment label. Must match the server environment.
NEXT_PUBLIC_PV_ENVIRONMENT=sandbox
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_CANONICAL_URL=https://provenanceverified.org

# Next.js server runtime
PV_ENVIRONMENT=sandbox
PV_SERVICE_MODE=sandbox
PV_AUTHORITY_API_URL=
PV_SUPABASE_URL=
PV_SUPABASE_PUBLISHABLE_KEY=
PV_AUTH_REQUIRE_AAL2=true

# Production activation: leave disabled until all gates and signatures exist.
PV_PRODUCTION_AUTHORITY_ENABLED=false
PV_PRODUCTION_ACTIVATION_RECORD_ID=
PV_PRODUCTION_ACTIVATION_RECORD_SHA256=

# Supabase authority-api Edge Function secrets and short-lived AWS workload identity.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PV_PUBLIC_CANONICAL_URL=https://provenanceverified.org
AWS_REGION=us-east-1
PV_AWS_WEB_IDENTITY_TOKEN=
PV_AUTHORITY_SERVICE_IDENTITY=provenance-cx-pilot-orchestrator
PV_AUTHORITY_PROVIDER_API_URL=https://REPLACE_PRIMARY.execute-api.us-east-1.amazonaws.com/pilot
PV_AWS_ROLE_ARN=arn:aws:iam::REPLACE_PRIMARY_ACCOUNT:role/provenance-cx-pilot-authority-orchestrator
PV_CUSTOS_PROVIDER_API_URL=https://REPLACE_CUSTOS.execute-api.us-east-1.amazonaws.com/pilot
PV_CUSTOS_AWS_ROLE_ARN=arn:aws:iam::REPLACE_CUSTOS_ACCOUNT:role/provenance-cx-custos-pilot-orchestrator

# R8.1 R3 signed production activation (required only for PV_ENVIRONMENT=production)
PV_PRODUCTION_ACTIVATION_RECORD_JSON_BASE64=
PV_PRODUCTION_ACTIVATION_PUBLIC_KEY_BASE64=
PV_RELEASE_COMMIT=
PV_RELEASE_PACKAGE_SHA256=
PV_INFRASTRUCTURE_VERSION=
PV_DATABASE_MIGRATION_VERSION=003_r3_full_corrective_authority
PV_SIGNING_KEY_ID=
PV_SIGNING_KEY_VERSION=
PV_CUSTOS_AUTHORITY_VERSION=
PV_REGISTRY_VERSION=
