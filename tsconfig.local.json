{
  "extends": "./tsconfig.audit.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".local-build",
    "rootDir": ".",
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "isolatedModules": false,
    "incremental": false,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".audit-types/**/*.d.ts"],
  "exclude": ["node_modules", "tests", "supabase", "review"]
}
