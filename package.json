{
  "name": "provenance-verified-website-v1",
  "version": "8.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run typecheck && NEXT_SKIP_INTERNAL_TYPECHECK=1 next build --turbopack",
    "start": "next start",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage --pool=forks --maxWorkers=4 --minWorkers=2",
    "test:unit": "vitest run tests/unit --pool=threads --maxWorkers=1 --minWorkers=1",
    "test:e2e": "playwright test",
    "test:accessibility": "playwright test tests/accessibility",
    "test:visual": "playwright test tests/visual",
    "test:performance": "playwright test tests/performance",
    "test:security": "vitest run tests/security --pool=threads --maxWorkers=1 --minWorkers=1",
    "audit:links": "node scripts/link-audit.mjs",
    "audit:continuity": "node scripts/continuity-lint.mjs",
    "audit:all": "npm run lint && npm run typecheck && npm run test && npm run build && npm run audit:links && npm run audit:continuity",
    "test:integration": "vitest run tests/integration --pool=threads --maxWorkers=1 --minWorkers=1",
    "fixtures:export": "vite-node scripts/export-authority-fixtures.ts",
    "audit:phase3": "python3 scripts/phase3-static-audit.py",
    "audit:phase4": "python3 scripts/phase4-static-audit.py",
    "audit:caliber": "python3 scripts/caliber-static-audit.py",
    "build:standalone": "node scripts/build-unified-standalone.mjs",
    "audit:r5:functional": "node scripts/r5-functional-audit.mjs",
    "audit:r5:release": "node scripts/r5-release-audit.mjs",
    "test:coverage": "vitest run --coverage --pool=forks --maxWorkers=4 --minWorkers=2",
    "verify:production": "node scripts/verify-production-authority.mjs",
    "typecheck:offline": "tsc -p tsconfig.audit.json --pretty false",
    "build:offline": "tsc -p tsconfig.local.json --pretty false",
    "test:local-authority": "node scripts/local-acceptance.cjs",
    "test:providers": "python3 scripts/provider-contract-audit.py",
    "audit:migration": "node scripts/migration-contract-audit.mjs",
    "test:recovery": "node --no-warnings scripts/recovery-simulation.mjs",
    "audit:source": "node scripts/source-quality-audit.mjs",
    "test:standalone-flow": "python3 scripts/standalone-flow-audit.py",
    "accept:no-deployment": "bash scripts/no-deployment-acceptance.sh",
    "audit:commercial": "node scripts/commercial-authority-audit.mjs",
    "accept:r3:local": "bash scripts/r3-local-acceptance.sh",
    "test:wave1:slice1": "vitest run tests/wave1/slice1-server-authorization.test.ts --pool=threads --maxWorkers=1 --minWorkers=1",
    "audit:wave1:slice1": "node scripts/wave1-slice1-static-audit.mjs",
    "audit:wave1:slice1:integration": "node scripts/wave1-slice1-integration-audit.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "3.10.0",
    "@types/qrcode": "1.5.5",
    "d3": "7.9.0",
    "next": "16.2.10",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "0.178.0",
    "zod": "3.25.76",
    "zustand": "5.0.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/d3": "7.4.3",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/three": "0.177.0",
    "@vitejs/plugin-react": "4.5.2",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.30.1",
    "eslint-config-next": "16.2.10",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "packageManager": "pnpm@11.14.0"
}
