{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "typeRoots": [
      "./.audit-types"
    ],
    "incremental": false,
    "noImplicitAny": false,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    ".audit-types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "supabase",
    "review",
    "tests/fixtures/source-quality"
  ]
}
